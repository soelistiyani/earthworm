#	wave_client.obj

$L\libew_util.lib: $(OBJS) libmseed signing
	lib /nologo /out:$@ *.obj
	copy *.obj $L

libmseed \
signing: PHONY
	@pushd $@ & \
		echo ---------- & \
		for /f "delims=" %d in ( 'cd' ) do @echo Making $@ in: %d & \
		$(MAKE) /$(MAKEFLAGS) /f makefile.nt & \
	popd
	

# Clean-up rules
clean:	clean\here \
	clean\libmseed \
	clean\signing

clean\here: PHONY
	-del core *.o *.obj *% *~
	-del $Llibew_util.a $Llibew_util.lib

clean\libmseed \
clean\signing: PHONY
	-@pushd $(@F) & \
		for /f "delims=" %d in ( 'cd' ) do @echo Cleaning in: %d & \
		$(MAKE) /$(MAKEFLAGS) /f makefile.nt clean & \
	popd

PHONY:
