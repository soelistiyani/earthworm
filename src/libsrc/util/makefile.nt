	fleng.obj \
	global_loc_rw.obj \
	global_pick_rw.obj \
	global_amp_rw.obj \
	global_msg.obj \
	gma.obj \
	geo_to_km.obj \
	geom.obj \
	get_ip_format_string.obj \
	getutil.obj \
	glevt_2_ewevent.obj \
	gseputaway.obj \
	k2evt2ew.obj \
	kom.obj \
	ioc_filter.obj \
	logit_mt.obj \
	lockfile.obj \
	make_triglist.obj \
	mem_circ_queue.obj \
	mnbrak.obj \
