# @(#)rtp2ew.scnl        2.0 08/13/2013
#
# Example table for use with import_rtp.  This file defines the
# mapping between the unit, stream, and channel entries which
# are in the DT packet headers and the station, channel, net,
# pin number parameters which are required by the TracePacket
# format.
#
# Note that stream number here is the one-based value that
# is used by people, not the zero-based value that is actually
# in the headers.  


#---------- DAS ------------|--------- TracePacket ----------
# Unit Id    Stream    Chan    Station   Channel   Net  Loc   Pinno SampRate(optional)
    BE5B        1        1      PAS1      BHZ      MN   --    1    200
    BE5B        1        2      PAS2      BHN      MN   --    2    200
    BE5B        1        3      PAS3      BHE      MN   --    3    200
    BE5B        1        4      PAS4      HHZ      MN   --    4    200
    BE5B        1        5      PAS5      HHN      MN   --    5    200
    BE5B        1        6      PAS6      HHE      MN   --    6    200 
